# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Database Configuration
DATABASE_URL=sqlite:///student_ai.db
DATABASE_DEBUG=false

# Azure Configuration (Optional)
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string
AZURE_COSMOS_CONNECTION_STRING=your_cosmos_connection_string
AZURE_FUNCTIONS_RUNTIME=python

# Application Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
MAX_TOKENS=2000
TEMPERATURE=0.7

# PDF Configuration
MAX_PDF_SIZE_MB=50
PDF_EXTRACTION_METHOD=pdfplumber
VECTOR_STORE_PATH=./vector_store

# Task Scheduler Configuration
SCHEDULE_CHECK_INTERVAL=3600
REMINDER_ADVANCE_HOURS=24

# Learning Configuration
DIFFICULTY_LEVELS=beginner,intermediate,advanced
DEFAULT_DIFFICULTY=intermediate